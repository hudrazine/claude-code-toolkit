{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "sandbox": {
    "enabled": true,
    "autoAllowBashIfSandboxed": true,
    "network": {
      "allowLocalBinding": true
    }
  },
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr close:*)",
      "Bash(gh issue close:*)",
      "Bash(gh release create:*)",
      "Bash(gh release delete:*)"
    ],
    "allow": [
      "Read(./.env.example)",
      "Edit(./.env.example)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Edit(./.env*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(gh repo delete:*)",
      "NotebookEdit"
    ]
  },
  "env": {
    "DISABLE_BUG_COMMAND": "1",
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "MCP_TOOL_TIMEOUT": "180000"
  }
}
